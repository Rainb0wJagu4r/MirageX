{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/2.0.0/crates/tauri-utils/schema/config.json",
  "productName": "MirageX",
  "version": "4.0.1",
  "identifier": "com.miragesecurity.miragex",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MirageX // Post-Quantum Cryptographic Engine & WRAITH v4",
        "width": 1050,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: tauri:;",
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "MirageX least-privilege capability",
          "windows": ["main"],
          "permissions": [
            "core:event:default",
            "core:window:default",
            "core:app:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/nobug.icns",
      "icons/wraith.icns",
      "icons/nobug.ico",
      "icons/wraith.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["wraith"],
        "name": "WRAITH Encrypted Container",
        "description": "MirageX WRAITH Post-Quantum Encrypted Container",
        "role": "Editor",
        "mimeType": "application/x-wraith",
        "exportedType": {
          "identifier": "com.miragesecurity.wraith",
          "conformsTo": ["public.data", "public.item"]
        }
      }
    ],
    "macOS": {
      "files": {
        "Resources/nobug.icns": "icons/nobug.icns",
        "Resources/wraith.icns": "icons/wraith.icns"
      },
      "infoPlist": "./Info.plist"
    }
  }
}
