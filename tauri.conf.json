{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/2.0.0/crates/tauri-utils/schema/config.json",
  "productName": "MirageX",
  "version": "4.0.0",
  "identifier": "com.miragesecurity.miragex",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MirageX // Post-Quantum Cryptographic Engine & WRAITH v4",
        "width": 1050,
        "height": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "MirageX capability",
          "windows": ["main"],
          "permissions": [
            "core:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
